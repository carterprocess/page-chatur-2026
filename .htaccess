# PAGECHAT: sem listagem de diretorios e sem acesso web a codigo/dados/cache.
Options -Indexes -Multiviews
DirectoryIndex index.php

# Bloqueia leitura direta (a pasta api/ e assets/ continuam publicas).
RewriteEngine On
RewriteRule ^(src|config|data|var|tests)(/|$) - [F,L]
RewriteRule (^|/)\.(git|ht) - [F,L]
RewriteRule ^(README\.md|\.gitignore)$ - [F,L]

# Assets sempre revalidados (modulos ES nao tem versao no nome).
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
